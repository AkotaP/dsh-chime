{
  "name": "dsh-chime",
  "version": "0.3.1",
  "description": "DSH web plugin: per-event notification chimes for approval, question, interruption and completion — each with its own source and volume, configured on the plugin's own page",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "package.json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkotaP/dsh-chime.git"
  },
  "bugs": {
    "url": "https://github.com/AkotaP/dsh-chime/issues"
  },
  "homepage": "https://github.com/AkotaP/dsh-chime#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sound",
    "notification",
    "chime"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": []
    }
  }
}
